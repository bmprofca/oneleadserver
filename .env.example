PORT=5823
DB_HOST=your_host
DB_USER=your_user
DB_PASSWORD=your_password
DB_NAME=your_database
# Optional: seed first admin on init-db / required for reset-users (10-digit mobile, no country code)
SEED_ADMIN_PHONE=
SEED_ADMIN_EMAIL=admin@onelead.com
# Session token lifetime (days). Tokens are opaque and stored hashed in user_sessions.
SESSION_TTL_DAYS=30
# Leave empty for production random OTP. Set a value only for local/dev bypass.
OTP_FIXED_CODE=
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
WHATSAPP_OTP_API_URL=https://server.onechatting.com/developer/message/send-template
WHATSAPP_OTP_TOKEN=your_developer_token
WHATSAPP_OTP_TEMPLATE_ID=your_template_id
